<rml>
<head>
    <title>GameSpeed · 游戏变速</title>
    <style>
        /* Original OreUI button sprites, sliced exactly like menus-theme. */
        @spritesheet oreui-buttons {
            src: oreui/textures/button-atlas.tga;
            resolution: 1x;
            ore-primary: 0px 0px 5px 7px;
            ore-primary-inner: 2px 2px 1px 1px;
            ore-primary-hover: 8px 0px 5px 7px;
            ore-primary-hover-inner: 10px 2px 1px 1px;
            ore-primary-pressed: 16px 0px 5px 5px;
            ore-primary-pressed-inner: 18px 2px 1px 1px;
            ore-primary-focus: 24px 0px 7px 9px;
            ore-primary-focus-inner: 27px 3px 1px 1px;
            ore-neutral: 0px 10px 5px 7px;
            ore-neutral-inner: 2px 12px 1px 1px;
            ore-neutral-hover: 8px 10px 5px 7px;
            ore-neutral-hover-inner: 10px 12px 1px 1px;
            ore-neutral-pressed: 16px 10px 5px 5px;
            ore-neutral-pressed-inner: 18px 12px 1px 1px;
            ore-neutral-focus: 24px 10px 7px 9px;
            ore-neutral-focus-inner: 27px 13px 1px 1px;
            ore-secondary: 0px 20px 5px 7px;
            ore-secondary-inner: 2px 22px 1px 1px;
            ore-secondary-hover: 8px 20px 5px 7px;
            ore-secondary-hover-inner: 10px 22px 1px 1px;
            ore-secondary-pressed: 16px 20px 5px 5px;
            ore-secondary-pressed-inner: 18px 22px 1px 1px;
            ore-secondary-focus: 24px 20px 7px 9px;
            ore-secondary-focus-inner: 27px 23px 1px 1px;
        }
        body { width: 100%; height: 100%; margin: 0; font-family: Ore UI; font-size: 13dp; color: #ffffff; }
        div { display: block; }
        button, input, #panel, #readout, .history-card, #numeric-wrap { box-sizing: border-box; }
        #panel-backdrop {
            position: absolute; left: 0; top: 0; width: 100%; height: 100%;
            display: none; z-index: 0; pointer-events: none; background-color: #00000033;
        }
        #panel {
            position: absolute; left: 20dp; top: 20dp; width: 580dp; max-width: 94%;
            display: none; z-index: 1; flex-direction: column; max-height: 92%; overflow: hidden;
            border: 2dp #1e1e1f; border-top: 4dp #6b6c6d;
            background-color: #313233; box-shadow: #00000099 0dp 8dp 0dp 0dp;
            animation: panel-arrive 0.16s cubic-out;
        }
        #panel.paused { border-top-color: #b1b2b5; }
        #startup-hint {
            position: absolute; right: 20dp; top: 20dp; width: 340dp; max-width: 90%;
            display: none; z-index: 2; box-sizing: border-box; padding: 16dp; pointer-events: none;
            border: 2dp #1e1e1f; border-top: 4dp #6b6c6d; background-color: #313233;
            box-shadow: #00000099 0dp 6dp 0dp 0dp;
        }
        #startup-hint * { pointer-events: none; }
        #startup-hint-header { display: flex; align-items: center; gap: 12dp; margin-bottom: 12dp; }
        #startup-hint-icon {
            width: 36dp; height: 40dp; box-sizing: border-box; border: 4dp #00000000; border-bottom-width: 8dp;
            font-family: Ore Ten; font-size: 16dp; line-height: 28dp; text-align: center;
            decorator: ninepatch(ore-primary, ore-primary-inner, 4dp 4dp 8dp 4dp) border-box;
        }
        #startup-hint-title { font-family: Ore Ten; font-size: 18dp; line-height: 24dp; }
        #startup-hint-subtitle { font-family: Ore Seven; font-size: 10dp; line-height: 14dp; color: #a0e081; }
        .startup-hint-step { display: flex; flex-wrap: wrap; align-items: center; gap: 4dp; font-size: 12dp; line-height: 24dp; }
        #startup-hint .key { font-size: 10dp; }
        .startup-hint-note { color: #b1b2b5; }
        #startup-hint-track { margin-top: 12dp; height: 4dp; background-color: #242425; }
        #startup-hint-progress { width: 100%; height: 4dp; background-color: #52a535; }
        @keyframes panel-arrive {
            from { opacity: 0; transform: translateY(8dp); }
            to { opacity: 1; transform: translateY(0dp); }
        }
        @keyframes live-breathe {
            from { opacity: 0.5; }
            to { opacity: 1; }
        }
        #drag-handle {
            position: relative; display: flex; align-items: center; height: 68dp; flex-shrink: 0;
            padding: 0 16dp; gap: 12dp; border-bottom: 2dp #1e1e1f;
            background-color: #48494a; cursor: move; drag: drag;
        }
        #monogram {
            width: 36dp; height: 36dp; line-height: 32dp; text-align: center;
            font-family: Ore Ten; font-size: 18dp; color: #ffffff;
            border: 2dp #00000000; border-bottom-width: 4dp;
            background-color: #00000000;
            decorator: ninepatch(ore-primary, ore-primary-inner, 4dp 4dp 8dp 4dp) border-box;
        }
        #title-block { flex: 1; min-width: 0; }
        #heading { font-family: Ore Ten; font-size: 24dp; line-height: 30dp; letter-spacing: 0.4dp; }
        #subtitle { font-family: Ore Seven; color: #d0d1d4; font-size: 11dp; line-height: 16dp; letter-spacing: 0.4dp; }
        #mode-pill {
            padding: 6dp 8dp; border: 2dp #1e1e1f; border-left: 4dp #52a535;
            color: #a0e081; font-family: Ore Seven; font-size: 11dp;
            background-color: #242425; white-space: nowrap;
        }
        #mode-pill.paused { color: #e6e6e8; border-left-color: #b1b2b5; }
        #mode-pill.boost { color: #a0e081; border-left-color: #6cc349; }
        #mode-pill.slow { color: #d0d1d4; border-left-color: #52a535; }
        #close { width: 36dp; height: 36dp; padding: 0; line-height: 24dp; font-family: Ore UI; font-size: 22dp; drag: block; }
        #workspace { position: relative; padding: 16dp 16dp 12dp; min-height: 0; flex-shrink: 1; overflow-x: hidden; overflow-y: auto; }
        #workspace scrollbarvertical { width: 8dp; margin-right: 4dp; background-color: #1e1e1f; }
        #workspace scrollbarvertical slidertrack { background-color: #1e1e1f; }
        #workspace scrollbarvertical sliderbar { width: 8dp; min-height: 24dp; border: 2dp #48494a; background-color: #8b8c90; }
        #workspace scrollbarvertical sliderbar:hover, #workspace scrollbarvertical sliderbar:active { background-color: #d0d1d4; }
        #workspace scrollbarvertical sliderarrowdec, #workspace scrollbarvertical sliderarrowinc { display: none; }
        #hero { display: flex; align-items: stretch; gap: 12dp; height: 132dp; }
        #readout { flex: 1; min-width: 218dp; padding: 10dp 12dp 8dp; background-color: #242425; border: 2dp #1e1e1f; border-bottom: 4dp #3c8527; }
        .eyebrow { font-family: Ore Seven; color: #d0d1d4; font-size: 12dp; line-height: 16dp; letter-spacing: 0.4dp; }
        #speed-readout { display: flex; align-items: baseline; height: 68dp; gap: 8dp; }
        #current-speed { font-family: Ore Seven; color: #ffffff; font-size: 54dp; line-height: 68dp; }
        #speed-unit { font-family: Ore Seven; font-size: 28dp; color: #a0e081; }
        #speed-caption { color: #b1b2b5; font-size: 11dp; line-height: 16dp; }
        .history-card { width: 256dp; padding: 10dp 12dp 8dp; border: 2dp #1e1e1f; border-bottom: 4dp #48494a; background-color: #242425; }
        .history-heading { display: flex; align-items: center; justify-content: space-between; font-size: 12dp; color: #ffffff; }
        #live-mark { display: flex; align-items: center; gap: 4dp; color: #a0e081; font-family: Ore Seven; font-size: 10dp; letter-spacing: 0.4dp; }
        #live-dot { width: 4dp; height: 4dp; background-color: #6cc349; animation: live-breathe 1.8s cubic-in-out infinite alternate; }
        #speed-history { display: flex; align-items: flex-end; gap: 4dp; height: 48dp; margin-top: 12dp; color: #b1b2b5; font-size: 11dp; border-bottom: 2dp #48494a; }
        .history-bar { flex: 1; min-height: 2dp; max-height: 100%; background-color: #3c8527; border-top: 2dp #52a535; transition: height opacity 0.2s cubic-out; }
        .history-bar.recent { background-color: #52a535; border-top-color: #6cc349; }
        .history-bar.latest { background-color: #6cc349; border-top-color: #a0e081; }
        .history-bar.paused { background-color: #6b6c6d; border-top-color: #b1b2b5; }
        .history-bar.empty { opacity: 0; }
        .history-meta { display: flex; justify-content: space-between; margin-top: 8dp; color: #b1b2b5; font-size: 11dp; }
        #held-duration { font-family: Ore Seven; color: #ffffff; }
        #preset-label { margin-top: 16dp; margin-bottom: 8dp; display: flex; justify-content: space-between; }
        #range-hint { font-family: Ore Seven; color: #b1b2b5; font-size: 11dp; }
        #presets { display: flex; gap: 8dp; }
        /* Transparent borders reserve layout space; original sprites paint the faces. */
        button {
            display: inline-block; padding: 0 8dp; height: 44dp; line-height: 32dp; text-align: center;
            font-family: Ore Seven; font-size: 14dp; color: #ffffff;
            border: 4dp #00000000; border-bottom-width: 8dp;
            background-color: #00000000; cursor: pointer; tab-index: auto;
            decorator: ninepatch(ore-neutral, ore-neutral-inner, 4dp 4dp 8dp 4dp) border-box;
        }
        button:hover { decorator: ninepatch(ore-neutral-hover, ore-neutral-hover-inner, 4dp 4dp 8dp 4dp) border-box; }
        button:focus-visible { decorator: ninepatch(ore-neutral-focus, ore-neutral-focus-inner, 6dp 6dp 10dp 6dp) border-box; }
        button:active { height: 40dp; border-bottom-width: 4dp; transform: translateY(4dp); decorator: ninepatch(ore-neutral-pressed, ore-neutral-pressed-inner, 4dp) border-box; }
        #close:active { height: 32dp; }
        input:focus-visible { box-shadow: #1e1e1f 0dp 0dp 0dp 2dp, #ffffff 0dp 0dp 0dp 4dp; }
        #presets button { flex: 1; padding: 0; }
        #presets button.selected, #apply, #pause {
            color: #ffffff; decorator: ninepatch(ore-primary, ore-primary-inner, 4dp 4dp 8dp 4dp) border-box;
        }
        #presets button.selected:hover, #apply:hover, #pause:hover { decorator: ninepatch(ore-primary-hover, ore-primary-hover-inner, 4dp 4dp 8dp 4dp) border-box; }
        #presets button.selected:focus-visible, #apply:focus-visible, #pause:focus-visible { decorator: ninepatch(ore-primary-focus, ore-primary-focus-inner, 6dp 6dp 10dp 6dp) border-box; }
        #presets button.selected:active, #apply:active, #pause:active { decorator: ninepatch(ore-primary-pressed, ore-primary-pressed-inner, 4dp) border-box; }
        #panel.paused #pause { decorator: ninepatch(ore-neutral, ore-neutral-inner, 4dp 4dp 8dp 4dp) border-box; }
        #panel.paused #pause:hover { decorator: ninepatch(ore-neutral-hover, ore-neutral-hover-inner, 4dp 4dp 8dp 4dp) border-box; }
        #panel.paused #pause:focus-visible { decorator: ninepatch(ore-neutral-focus, ore-neutral-focus-inner, 6dp 6dp 10dp 6dp) border-box; }
        #panel.paused #pause:active { decorator: ninepatch(ore-neutral-pressed, ore-neutral-pressed-inner, 4dp) border-box; }
        #precision { display: flex; flex-wrap: wrap; gap: 8dp; align-items: center; margin-top: 16dp; }
        #value-controls, #transport-controls { display: flex; align-items: center; flex-shrink: 0; gap: 8dp; }
        #numeric-wrap { display: flex; height: 44dp; align-items: center; border: 2dp #1e1e1f; border-top: 4dp #151516; border-bottom-color: #58585a; background-color: #242425; }
        #speed-input { width: 78dp; height: 38dp; padding: 8dp; font-family: Ore Seven; color: #ffffff; background-color: #00000000; border: 0dp; font-size: 16dp; tab-index: auto; }
        #unit { padding-right: 8dp; font-family: Ore Seven; color: #d0d1d4; font-size: 14dp; }
        #apply { width: 68dp; }
        #precision-gap { flex: 1; }
        #pause { width: 132dp; }
        #reset { width: 100dp; color: #1e1e1f; decorator: ninepatch(ore-secondary, ore-secondary-inner, 4dp 4dp 8dp 4dp) border-box; }
        #reset:hover { decorator: ninepatch(ore-secondary-hover, ore-secondary-hover-inner, 4dp 4dp 8dp 4dp) border-box; }
        #reset:focus-visible { decorator: ninepatch(ore-secondary-focus, ore-secondary-focus-inner, 6dp 6dp 10dp 6dp) border-box; }
        #reset:active { decorator: ninepatch(ore-secondary-pressed, ore-secondary-pressed-inner, 4dp) border-box; }
        /* BaseSlider uses a square thumb with a separate, straight lower face. */
        #slider-section { margin-top: 16dp; padding: 12dp; border: 2dp #1e1e1f; background-color: #242425; }
        #slider-heading { display: flex; align-items: center; justify-content: space-between; gap: 8dp; }
        #slider-title { font-family: Ore Ten; font-size: 14dp; line-height: 20dp; }
        #slider-meta { display: flex; align-items: center; gap: 8dp; }
        #slider-caption { color: #b1b2b5; font-size: 11dp; line-height: 16dp; }
        #slider-value { padding: 2dp 8dp; border: 2dp #1e1e1f; background-color: #313233; font-family: Ore Seven; color: #a0e081; font-size: 14dp; line-height: 20dp; white-space: nowrap; }
        #panel.paused #slider-value { color: #d0d1d4; }
        #slider-track-area { position: relative; margin-top: 8dp; }
        #speed-slider { display: block; width: 100%; height: 48dp; margin: 0; border: 0dp; tab-index: auto; }
        #speed-slider slidertrack, #speed-slider sliderprogress, #speed-slider sliderbar { box-sizing: border-box; }
        #speed-slider slidertrack {
            height: 12dp; margin-top: 18dp; border: 2dp #1e1e1f; overflow: hidden;
            background-color: #8c8d90;
            box-shadow: #ffffff33 0dp 2dp 0dp 0dp inset, #ffffff19 2dp 0dp 0dp 0dp inset, #00000026 0dp -2dp 0dp 0dp inset;
        }
        #speed-slider sliderprogress {
            height: 8dp; margin-left: 2dp; margin-top: 2dp; border: 0dp; background-color: #3c8527;
            box-shadow: #ffffff33 0dp 2dp 0dp 0dp inset, #ffffff19 2dp 0dp 0dp 0dp inset, #00000026 0dp -2dp 0dp 0dp inset;
        }
        #speed-slider sliderbar {
            width: 32dp; height: 32dp; margin-left: 0dp; margin-right: 0dp; margin-top: 8dp;
            border: 2dp #1e1e1f; background-color: #d0d1d4; cursor: pointer; decorator: none;
            /* Resolve the original 60%/40% white reflection against the face,
               so overlapping square strips do not brighten the corners twice. */
            box-shadow: #58585a 0dp -4dp 0dp 0dp inset, #ecedee 0dp 2dp 0dp 0dp inset, #ecedee 2dp 0dp 0dp 0dp inset, #e3e3e5 -2dp 0dp 0dp 0dp inset, #e3e3e5 0dp -6dp 0dp 0dp inset;
        }
        #speed-slider sliderbar:hover, #speed-slider sliderbar:active, #speed-slider:active sliderbar {
            background-color: #b1b2b5;
            box-shadow: #58585a 0dp -4dp 0dp 0dp inset, #eff0f0 0dp 2dp 0dp 0dp inset, #eff0f0 2dp 0dp 0dp 0dp inset, #e0e0e1 -2dp 0dp 0dp 0dp inset, #e0e0e1 0dp -6dp 0dp 0dp inset;
        }
        #speed-slider:focus-visible { box-shadow: none; }
        #speed-slider:focus-visible sliderbar { box-shadow: #58585a 0dp -4dp 0dp 0dp inset, #ecedee 0dp 2dp 0dp 0dp inset, #ecedee 2dp 0dp 0dp 0dp inset, #e3e3e5 -2dp 0dp 0dp 0dp inset, #e3e3e5 0dp -6dp 0dp 0dp inset, #242425 0dp 0dp 0dp 2dp, #ffffff 0dp 0dp 0dp 4dp; }
        #speed-slider:focus-visible sliderbar:hover, #speed-slider:focus-visible sliderbar:active, #speed-slider:focus-visible:active sliderbar { box-shadow: #58585a 0dp -4dp 0dp 0dp inset, #eff0f0 0dp 2dp 0dp 0dp inset, #eff0f0 2dp 0dp 0dp 0dp inset, #e0e0e1 -2dp 0dp 0dp 0dp inset, #e0e0e1 0dp -6dp 0dp 0dp inset, #242425 0dp 0dp 0dp 2dp, #ffffff 0dp 0dp 0dp 4dp; }
        #speed-slider.paused sliderprogress { background-color: #6b6c6d; }
        #speed-slider sliderarrowdec, #speed-slider sliderarrowinc { display: none; }
        #slider-ticks { position: absolute; left: 18dp; right: 18dp; top: 42dp; height: 6dp; pointer-events: none; }
        .slider-tick { position: absolute; top: 0; width: 2dp; height: 4dp; background-color: #6b6c6d; transform: translateX(-1dp); }
        .slider-tick.normal { height: 6dp; background-color: #52a535; }
        #scale-labels { position: relative; height: 34dp; margin: 0 18dp; font-family: Ore Seven; font-size: 11dp; color: #b1b2b5; line-height: 16dp; pointer-events: none; }
        .scale-label { position: absolute; top: 0; width: 48dp; text-align: center; transform: translateX(-50%); }
        .scale-label.normal { color: #ffffff; }
        .normal-speed-label { display: block; color: #a0e081; font-family: Ore UI; font-size: 10dp; line-height: 14dp; }
        #input-error { color: #ff9d9d; font-size: 12dp; line-height: 16dp; }
        #status-row { display: flex; flex-wrap: wrap; gap: 4dp; align-items: center; justify-content: space-between; margin-top: 12dp; padding-top: 12dp; border-top: 2dp #48494a; }
        #clock-status { color: #d0d1d4; font-size: 11dp; line-height: 16dp; }
        #time-note { color: #b1b2b5; font-size: 11dp; white-space: nowrap; }
        #help { position: relative; display: flex; flex-wrap: wrap; flex-shrink: 0; gap: 4dp; justify-content: space-between; align-items: center; padding: 8dp 16dp 12dp; border-top: 2dp #1e1e1f; background-color: #242425; color: #d0d1d4; font-size: 11dp; line-height: 20dp; }
        #shortcuts { display: flex; flex-wrap: wrap; align-items: center; gap: 4dp; }
        .key { display: inline-block; padding: 0 4dp; line-height: 16dp; font-family: Ore Seven; color: #ffffff; border: 2dp #00000000; border-bottom-width: 4dp; background-color: #00000000; decorator: ninepatch(ore-neutral, ore-neutral-inner, 2dp 2dp 4dp 2dp) border-box; }
        #move-help { color: #b1b2b5; }
        @media (max-width: 560dp) {
            #panel { width: 94%; left: 3%; top: 12dp; }
            #drag-handle { padding: 0 12dp; gap: 8dp; }
            #workspace { padding: 12dp 12dp 10dp; }
            #hero { gap: 8dp; }
            #readout { min-width: 160dp; padding-left: 8dp; padding-right: 8dp; }
            #current-speed { font-size: 48dp; }
            .history-card { width: 210dp; padding-left: 8dp; padding-right: 8dp; }
            #presets { gap: 4dp; }
            #presets button { font-size: 12dp; }
            #pause { width: 124dp; }
            #reset { width: 96dp; }
            #help { padding-left: 12dp; padding-right: 12dp; }
        }
        @media (max-width: 430dp) {
            #hero { flex-direction: column; height: 272dp; gap: 8dp; }
            #readout { flex: 0 0 auto; min-width: 0; height: 132dp; }
            .history-card { flex-shrink: 0; width: 100%; height: 132dp; }
            #precision { justify-content: space-between; row-gap: 12dp; }
            #precision-gap { display: none; }
            #mode-pill { padding-left: 4dp; padding-right: 4dp; font-size: 10dp; }
            #heading { font-size: 20dp; }
            #subtitle { font-size: 10dp; }
            #monogram { width: 28dp; height: 32dp; font-size: 15dp; line-height: 28dp; }
            #close { width: 32dp; }
            #presets button { font-size: 11dp; border-left-width: 2dp; border-right-width: 2dp; }
        }
    </style>
</head>
<body>
    <div id="panel-backdrop"></div>
    <div id="startup-hint">
        <div id="startup-hint-header">
            <div id="startup-hint-icon">GS</div>
            <div><div id="startup-hint-title">游戏变速已就绪</div><div id="startup-hint-subtitle">GAME SPEED</div></div>
        </div>
        <div class="startup-hint-step"><span>按</span><span class="key">F8</span><span>或</span><span class="key">Ctrl+Shift+G</span><span>打开面板</span></div>
        <div class="startup-hint-step startup-hint-note"><span>笔记本可用</span><span class="key">Fn+F8</span></div>
        <div class="startup-hint-step startup-hint-note"><span class="key">Esc</span><span>收起面板</span></div>
        <div id="startup-hint-track"><div id="startup-hint-progress"></div></div>
    </div>
    <div id="panel">
        <div id="drag-handle">
            <div id="monogram">GS</div>
            <div id="title-block">
                <div id="heading">游戏变速</div>
                <div id="subtitle">GAME SPEED / CONTROL</div>
            </div>
            <div id="mode-pill">等待计时状态</div>
            <button id="close">×</button>
        </div>
        <div id="workspace">
            <div id="hero">
                <div id="readout">
                    <div class="eyebrow">实时倍率 / GAME SPEED</div>
                    <div id="speed-readout"><div id="current-speed">1.00</div><span id="speed-unit">×</span></div>
                    <div id="speed-caption">以你的节奏探索世界</div>
                </div>
                <div class="history-card">
                    <div class="history-heading">
                        <span>倍率轨迹</span>
                        <div id="live-mark"><div id="live-dot"></div><span>LIVE</span></div>
                    </div>
                    <div id="speed-history">等待倍率采样</div>
                    <div class="history-meta"><span>当前倍率持续</span><span id="held-duration">--:--</span></div>
                </div>
            </div>
            <div id="preset-label" class="eyebrow"><span>快速切换 / PRESETS</span><span id="range-hint">0.01 – 16.00×</span></div>
            <div id="presets">
                <button data-speed="0.25">0.25×</button>
                <button data-speed="0.5">0.5×</button>
                <button data-speed="1" class="selected">1×</button>
                <button data-speed="2">2×</button>
                <button data-speed="4">4×</button>
                <button data-speed="8">8×</button>
            </div>
            <div id="precision">
                <div id="value-controls">
                    <div id="numeric-wrap"><input id="speed-input" type="text" value="1.00" maxlength="8" /><span id="unit">×</span></div>
                    <button id="apply">应用</button>
                </div>
                <div id="precision-gap"></div>
                <div id="transport-controls">
                    <button id="pause">暂停 / Pause</button>
                    <button id="reset">重置 / 1×</button>
                </div>
            </div>
            <div id="slider-section">
                <div id="slider-heading">
                    <span id="slider-title">倍率调节</span>
                    <div id="slider-meta"><span id="slider-caption">拖动调节</span><span id="slider-value">1.00×</span></div>
                </div>
                <div id="slider-track-area">
                    <input id="speed-slider" type="range" min="0" max="100" step="0.1" value="50" />
                    <div id="slider-ticks">
                        <div class="slider-tick" style="left: 0%;"></div>
                        <div class="slider-tick" style="left: 25%;"></div>
                        <div class="slider-tick normal" style="left: 50%;"></div>
                        <div class="slider-tick" style="left: 75%;"></div>
                        <div class="slider-tick" style="left: 100%;"></div>
                    </div>
                </div>
                <div id="scale-labels">
                    <span class="scale-label" style="left: 0%;">0.01×</span>
                    <span class="scale-label" style="left: 25%;">0.1×</span>
                    <span class="scale-label normal" style="left: 50%;">1×<span class="normal-speed-label">正常速度</span></span>
                    <span class="scale-label" style="left: 75%;">4×</span>
                    <span class="scale-label" style="left: 100%;">16×</span>
                </div>
            </div>
            <div id="input-error"></div>
            <div id="status-row"><div id="clock-status">等待游戏计时状态…</div><span id="time-note">暂停时面板仍可操作</span></div>
        </div>
        <div id="help">
            <div id="shortcuts"><span class="key">F8</span><span>/</span><span class="key">Ctrl+Shift+G</span><span>显示 / 隐藏</span><span class="key">Esc</span><span>收起</span></div>
            <span id="move-help">拖动标题栏移动</span>
        </div>
    </div>
</body>
</rml>
