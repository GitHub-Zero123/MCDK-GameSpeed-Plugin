<rml>
<head>
    <title>GameSpeed · 游戏变速</title>
    <style>
        body { width: 100%; height: 100%; margin: 0; font-family: Lato; font-size: 13dp; color: #e9f0f6; }
        div { display: block; }
        button, input, #panel, .history-card { box-sizing: border-box; }
        #panel {
            position: absolute; left: 20dp; top: 20dp; width: 580dp; max-width: 94%;
            display: flex; flex-direction: column; max-height: 92%;
            border: 1dp #5b6a805e; border-radius: 18dp; overflow: hidden;
            background-color: #0d1521ed;
            decorator: linear-gradient(125deg, #2337478c, #131b298c 48%, #211d3780);
            backdrop-filter: blur(14dp);
            box-shadow: #02060c99 0dp 18dp 44dp 3dp, #6ce1d31a 0dp 0dp 34dp 0dp, #ffffff0b 0dp 1dp 0dp 0dp inset;
            animation: panel-arrive 0.35s cubic-out;
            transition: border-color 0.2s cubic-out;
        }
        #panel.paused { border-color: #b69d705e; }
        #panel.dragging { border-color: #a1e7dba0; box-shadow: #02060cbc 0dp 22dp 50dp 4dp, #6ce1d32a 0dp 0dp 38dp 0dp; }
        @keyframes panel-arrive {
            from { opacity: 0; transform: translateY(12dp) scale(0.985); }
            to { opacity: 1; transform: translateY(0dp) scale(1); }
        }
        @keyframes ambient-breathe {
            from { opacity: 0.4; transform: translateX(0dp); }
            to { opacity: 0.7; transform: translateX(14dp); }
        }
        @keyframes live-breathe {
            from { opacity: 0.45; }
            to { opacity: 1; }
        }
        .ambient { position: absolute; pointer-events: none; z-index: 0; border-radius: 90dp; filter: blur(16dp); }
        #ambient-teal { left: -60dp; top: 35dp; width: 240dp; height: 150dp; decorator: radial-gradient(#63e7c828, #63e7c800); animation: ambient-breathe 5s cubic-in-out infinite alternate; }
        #ambient-violet { right: -50dp; top: 100dp; width: 210dp; height: 175dp; decorator: radial-gradient(#9582f331, #9582f300); animation: ambient-breathe 7s cubic-in-out infinite alternate; }
        #drag-handle {
            position: relative; z-index: 1; display: flex; align-items: center; height: 60dp;
            flex-shrink: 0;
            padding: 0 18dp; gap: 11dp; border-bottom: 1dp #9aabc41a; cursor: move; drag: drag;
            decorator: horizontal-gradient(#83e7d708 #9d86ed08);
        }
        #monogram {
            width: 34dp; height: 34dp; line-height: 34dp; text-align: center; font-size: 14dp; font-weight: bold;
            color: #c8fff1; border: 1dp #71dcca59; border-radius: 10dp;
            decorator: linear-gradient(135deg, #488b8755, #284d6555);
            box-shadow: #65ddcb26 0dp 0dp 15dp 0dp;
        }
        #title-block { flex: 1; }
        #heading { font-size: 19dp; font-weight: bold; line-height: 24dp; letter-spacing: 0.4dp; }
        #subtitle { color: #8c9eb2; font-size: 10dp; line-height: 15dp; letter-spacing: 1dp; }
        #mode-pill {
            padding: 5dp 9dp; border-radius: 20dp; border: 1dp #71dcca40;
            color: #99e9d5; font-size: 11dp; background-color: #1b433a66; white-space: nowrap;
            transition: background-color color border-color 0.18s cubic-out;
        }
        #mode-pill.paused { color: #e3c193; background-color: #63493255; border-color: #d2ab7d50; }
        #mode-pill.boost { color: #cbbdff; background-color: #4c3b6f55; border-color: #aa91ed55; }
        #mode-pill.slow { color: #a5d9f1; background-color: #29486255; border-color: #81b4d755; }
        #close {
            width: 28dp; height: 28dp; padding: 0; line-height: 26dp; font-size: 21dp; border-radius: 8dp;
            background-color: #ffffff05; border-color: #ffffff18; color: #a5b3c5; drag: block;
        }
        #close:hover { color: #fff; background-color: #e38e8e24; border-color: #e38e8e66; }
        #workspace { position: relative; z-index: 1; padding: 14dp 18dp 10dp; min-height: 0; flex-shrink: 1; overflow-x: hidden; overflow-y: auto; }
        #workspace scrollbarvertical { width: 4dp; margin-right: 4dp; background-color: #7b91ae10; border-radius: 4dp; }
        #workspace scrollbarvertical slidertrack { background-color: #0000; }
        #workspace scrollbarvertical sliderbar { width: 4dp; min-height: 24dp; border-radius: 4dp; background-color: #88baac70; transition: background-color 0.15s cubic-out; }
        #workspace scrollbarvertical sliderbar:hover, #workspace scrollbarvertical sliderbar:active { background-color: #adebdaa0; }
        #workspace scrollbarvertical sliderarrowdec, #workspace scrollbarvertical sliderarrowinc { display: none; }
        #hero { display: flex; align-items: stretch; gap: 18dp; height: 104dp; }
        #readout { flex: 1; min-width: 218dp; }
        .eyebrow { color: #92a4bb; font-size: 11dp; line-height: 16dp; letter-spacing: 0.5dp; }
        #speed-readout { display: flex; align-items: baseline; height: 68dp; gap: 6dp; }
        #current-speed { color: #bafced; font-size: 60dp; font-weight: bold; line-height: 68dp; letter-spacing: -1.2dp; }
        #speed-unit { font-size: 27dp; color: #73b9a9; }
        #speed-caption { color: #77938f; font-size: 11dp; line-height: 16dp; }
        .history-card {
            width: 255dp; padding: 10dp 13dp 8dp; border: 1dp #8294b328; border-radius: 12dp;
            background-color: #0b132b60; decorator: linear-gradient(145deg, #6489ba12, #8a62b619);
        }
        .history-heading { display: flex; align-items: center; justify-content: space-between; font-size: 11dp; color: #adbad0; }
        #live-mark { display: flex; align-items: center; gap: 5dp; color: #84c3b4; font-size: 9dp; letter-spacing: 0.8dp; }
        #live-dot { width: 4dp; height: 4dp; border-radius: 4dp; background-color: #8febd4; box-shadow: #83e5cc90 0dp 0dp 6dp 0dp; animation: live-breathe 1.8s cubic-in-out infinite alternate; }
        #speed-history {
            display: flex; align-items: flex-end; gap: 4dp; height: 44dp; margin-top: 9dp;
            color: #657a91; font-size: 10dp; border-bottom: 1dp #677c9824;
        }
        .history-bar {
            flex: 1; min-height: 2dp; max-height: 100%; border-radius: 3dp 3dp 0dp 0dp;
            decorator: vertical-gradient(#81dbcfe8 #416d9270);
            transition: height opacity 0.3s cubic-out;
        }
        .history-bar.recent { decorator: vertical-gradient(#a6ccf0e8 #596a9870); }
        .history-bar.latest { decorator: vertical-gradient(#c3b1fff5 #847ab390); }
        .history-bar.paused { decorator: vertical-gradient(#c7a97799 #6f5c4766); }
        .history-bar.empty { opacity: 0; }
        .history-meta { display: flex; justify-content: space-between; margin-top: 7dp; color: #7e92aa; font-size: 10dp; }
        #held-duration { color: #acbdd0; }
        #preset-label { margin-top: 12dp; margin-bottom: 7dp; display: flex; justify-content: space-between; }
        #range-hint { color: #75879e; font-size: 10dp; }
        #presets { display: flex; gap: 8dp; }
        button {
            display: inline-block; padding: 0 10dp; height: 33dp; line-height: 31dp; text-align: center;
            font-size: 12dp; color: #b9c7d9; border: 1dp #62759140; border-radius: 8dp;
            background-color: #25344970; cursor: pointer; tab-index: auto;
            transition: background-color border-color color transform 0.16s cubic-out;
        }
        button:hover { background-color: #42647d75; border-color: #8dbcc380; color: #eafff9; transform: translateY(-1dp); }
        button:active { background-color: #457f7caa; transform: translateY(1dp) scale(0.98); }
        button:focus-visible, input:focus-visible { border-color: #a4e9dc; box-shadow: #79dcca35 0dp 0dp 8dp 0dp; }
        #presets button { flex: 1; padding: 0; }
        #presets button.selected { color: #c7fff0; border-color: #7ddac582; background-color: #28594e80; box-shadow: #62d8b914 0dp 0dp 12dp 0dp inset; }
        #precision { display: flex; flex-wrap: wrap; gap: 8dp; align-items: center; margin-top: 12dp; }
        #value-controls, #transport-controls { display: flex; align-items: center; flex-shrink: 0; gap: 8dp; }
        #numeric-wrap { display: flex; height: 33dp; align-items: center; border: 1dp #67809b50; border-radius: 8dp; background-color: #08111e99; }
        #speed-input { width: 72dp; height: 31dp; padding: 6dp 10dp; color: #e1f5f1; background-color: #0000; border: 0dp; font-size: 13dp; tab-index: auto; }
        #unit { padding-right: 10dp; color: #758ea0; font-size: 12dp; }
        #apply { width: 65dp; color: #9ce4d4; border-color: #64bcaa60; background-color: #20494366; }
        #precision-gap { flex: 1; }
        #pause { width: 132dp; color: #d9fff5; border-color: #8ce7d879; decorator: horizontal-gradient(#39776d80 #335e7e80); }
        #pause:hover { background-color: #589e8e55; box-shadow: #7cddc930 0dp 0dp 15dp 0dp; }
        #reset { width: 99dp; }
        #speed-slider { display: block; width: 100%; height: 26dp; margin-top: 7dp; tab-index: auto; }
        #speed-slider slidertrack { height: 5dp; margin-top: 11dp; border-radius: 5dp; background-color: #55688035; }
        #speed-slider sliderprogress { height: 5dp; border-radius: 5dp; decorator: horizontal-gradient(#58b9ad #aa9bdf); }
        #speed-slider sliderbar {
            width: 15dp; height: 15dp; margin-left: -7dp; margin-right: -7dp; margin-top: 6dp;
            border: 1dp #ddfff7; border-radius: 15dp; background-color: #8ddfcb; cursor: pointer;
            box-shadow: #70d9c74d 0dp 0dp 10dp 1dp; transition: background-color transform 0.15s cubic-out;
        }
        #speed-slider sliderbar:hover { background-color: #e7fff6; transform: scale(1.15); }
        #speed-slider sliderbar:active { background-color: #c6bafa; }
        #speed-slider sliderarrowdec, #speed-slider sliderarrowinc { display: none; }
        #scale-labels { display: flex; justify-content: space-between; font-size: 10dp; color: #677d96; line-height: 14dp; }
        #input-error { color: #efb899; font-size: 11dp; line-height: 14dp; }
        #status-row { display: flex; flex-wrap: wrap; gap: 4dp; align-items: center; justify-content: space-between; margin-top: 10dp; padding-top: 10dp; border-top: 1dp #8a9bb222; }
        #clock-status { color: #829ab0; font-size: 10dp; line-height: 15dp; }
        #time-note { color: #72879f; font-size: 10dp; white-space: nowrap; }
        #help {
            position: relative; z-index: 1; display: flex; flex-wrap: wrap; flex-shrink: 0; gap: 4dp; justify-content: space-between; align-items: center;
            padding: 9dp 18dp 11dp; border-top: 1dp #889abb1c; background-color: #08101b38;
            color: #8296ac; font-size: 10dp; line-height: 17dp;
        }
        #shortcuts { display: flex; flex-wrap: wrap; align-items: center; gap: 5dp; }
        .key { display: inline-block; padding: 0dp 5dp; line-height: 16dp; color: #b7c8d8; border: 1dp #7d94ae40; border-radius: 4dp; background-color: #a5bdd10a; }
        #move-help { color: #647b94; }
        @media (max-width: 560dp) {
            #panel { width: 94%; left: 3%; top: 12dp; }
            #drag-handle { padding: 0 12dp; gap: 8dp; }
            #workspace { padding: 12dp 12dp 10dp; }
            #hero { gap: 10dp; }
            #readout { min-width: 160dp; }
            #current-speed { font-size: 49dp; }
            .history-card { width: 210dp; padding-left: 9dp; padding-right: 9dp; }
            #presets { gap: 5dp; }
            #precision { gap: 5dp; }
            #value-controls, #transport-controls { gap: 5dp; }
            #pause { width: 115dp; }
            #reset { width: 88dp; }
            #help { padding-left: 12dp; padding-right: 12dp; }
        }
        @media (max-width: 430dp) {
            #hero { flex-direction: column; height: 220dp; gap: 12dp; }
            #readout { flex: 0 0 auto; min-width: 0; height: 104dp; }
            .history-card { flex-shrink: 0; width: 100%; height: 104dp; }
            #precision { justify-content: space-between; row-gap: 8dp; }
            #precision-gap { display: none; }
            #mode-pill { padding-left: 6dp; padding-right: 6dp; font-size: 10dp; }
            #subtitle { letter-spacing: 0.4dp; }
        }
    </style>
</head>
<body>
    <div id="panel">
        <div id="ambient-teal" class="ambient"></div>
        <div id="ambient-violet" class="ambient"></div>
        <div id="drag-handle">
            <div id="monogram">GS</div>
            <div id="title-block">
                <div id="heading">游戏变速</div>
                <div id="subtitle">GAME SPEED / MCDK</div>
            </div>
            <div id="mode-pill">等待计时状态</div>
            <button id="close">×</button>
        </div>
        <div id="workspace">
            <div id="hero">
                <div id="readout">
                    <div class="eyebrow">实时倍率 / PLAYBACK RATE</div>
                    <div id="speed-readout"><div id="current-speed">1.00</div><span id="speed-unit">×</span></div>
                    <div id="speed-caption">让游戏跟随你的节奏</div>
                </div>
                <div class="history-card">
                    <div class="history-heading">
                        <span>倍率轨迹</span>
                        <div id="live-mark"><div id="live-dot"></div><span>LIVE HISTORY</span></div>
                    </div>
                    <div id="speed-history">等待倍率采样</div>
                    <div class="history-meta"><span>当前倍率持续</span><span id="held-duration">--:--</span></div>
                </div>
            </div>
            <div id="preset-label" class="eyebrow"><span>快速切换 / PRESETS</span><span id="range-hint">0.01 – 16.00×</span></div>
            <div id="presets">
                <button data-speed="0.25">0.25×</button>
                <button data-speed="0.5">0.5×</button>
                <button data-speed="1" class="selected">1×</button>
                <button data-speed="2">2×</button>
                <button data-speed="4">4×</button>
                <button data-speed="8">8×</button>
            </div>
            <div id="precision">
                <div id="value-controls">
                    <div id="numeric-wrap"><input id="speed-input" type="text" value="1.00" maxlength="8" /><span id="unit">×</span></div>
                    <button id="apply">应用</button>
                </div>
                <div id="precision-gap"></div>
                <div id="transport-controls">
                    <button id="pause">暂停 / Pause</button>
                    <button id="reset">重置 / 1×</button>
                </div>
            </div>
            <input id="speed-slider" type="range" min="0.01" max="16" step="0.01" value="1" />
            <div id="scale-labels"><span>0.01× · 慢速</span><span>16× · 加速</span></div>
            <div id="input-error"></div>
            <div id="status-row"><div id="clock-status">等待游戏计时状态…</div><span id="time-note">暂停时面板仍可操作</span></div>
        </div>
        <div id="help">
            <div id="shortcuts"><span class="key">F8</span><span>/</span><span class="key">Ctrl+Shift+G</span><span>显示 / 隐藏</span><span class="key">Esc</span><span>收起</span></div>
            <span id="move-help">拖动标题栏移动</span>
        </div>
    </div>
</body>
</rml>
